# ==============================
# Provider WhatsMeow - .env.example
# ==============================

# ---- Core ----
HTTP_ADDR=:8080
SESSION_STORE=./state/whatsmeow
LOG_LEVEL=debug
UI_ENABLED=true
UI_TITLE=WhatsMeow Control Center
# Protect dashboard + frontend API routes (/ /assets /api /sessions)
UI_AUTH_ENABLED=false
UI_AUTH_USER=
UI_AUTH_PASS=
UI_AUTH_REALM=WhatsMeow Dashboard

# API token auth (Cloud API style)
# If API_AUTH_TOKEN is set, API auth can be enabled to protect endpoints.
API_AUTH_ENABLED=true
API_AUTH_TOKEN=9cfef7bd-ac83-4af5-873d-fe8340ffe754
# Compat alias also accepted: UNOAPI_AUTH_TOKEN
# Allow /path?access_token=... in addition to Authorization: Bearer ...
API_AUTH_ALLOW_QUERY=true

# ---- AMQP (incoming/outgoing queue consumption) ----
AMQP_CONSUMER_ENABLED=true
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_EXCHANGE=provider.whatsmeow.outgoing
AMQP_QUEUE=outgoing.whatsmeow.worker-a
AMQP_BINDING=provider.whatsmeow.*
# Optional explicit bindings (overrides AMQP_BINDING)
# AMQP_BINDINGS=provider.whatsmeow.5562991111111,provider.whatsmeow.5562992222222
AMQP_BINDING_PREFIX=provider.whatsmeow

# ---- Worker assignment ----
WORKER_ID=worker-a
# Optional bootstrap list. You can leave empty and configure sessions via dashboard.
WORKER_NUMBERS=
WORKER_STRICT_ASSIGNMENT=true
WORKER_AUTOCONNECT_ASSIGNED=true

# ---- Media storage (Cloud API compatible endpoints) ----
# auto: uses S3 when fully configured, otherwise local filesystem
# local: always filesystem
# s3: force S3 (falls back to local if mandatory creds are missing)
MEDIA_STORAGE_MODE=auto
MEDIA_STORE_DIR=./state/whatsmeow/_media
MEDIA_REGISTRY_FILE=./state/whatsmeow/_media_registry.json
# URL expiry used for S3 pre-signed links on media metadata endpoint
MEDIA_URL_TTL_SECONDS=259200

# ---- S3 (optional) ----
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional object prefix inside the bucket
S3_PREFIX=
# UnoAPI-style aliases also supported:
# STORAGE_BUCKET_NAME / STORAGE_REGION / STORAGE_ENDPOINT
# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY
# STORAGE_FORCE_PATH_STYLE / STORAGE_PREFIX

# ---- Webhook outputs ----
AMQP_WEBHOOK_EXCHANGE=provider.whatsmeow.webhooks
# Webhooks por sessão podem ser cadastrados no dashboard/API.
# WEBHOOK_BASE é apenas fallback HTTP quando não houver webhook cadastrado.
WEBHOOK_BASE=

# ---- Redis (optional) ----
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
STATUS_PREFIX=provider-whatsmeow-status:
SESSION_CONFIG_PREFIX=provider-whatsmeow-config:

# ---- WhatsApp behavior ----
AUDIO_PTT_DEFAULT=true
REJECT_CALLS=true
REJECT_CALLS_MESSAGE=Nao aceitamos ligacoes pelo WhatsApp. Envie uma mensagem.
MARK_READ_ON_MESSAGE=false
CHECK_USER_EXISTS=true
IGNORE_STATUS_BROADCAST=true
IGNORE_NEWSLETTERS=true
# Compatibilidade Chatwoot (mensagens enviadas do próprio celular como outgoing):
# false => value.messages (padrão Cloud)
# true  => value.message_echoes + field=smb_message_echoes
OUTGOING_MESSAGES_COEX=false
ALWAYS_ONLINE=false
ALWAYS_ONLINE_INTERVAL_SECONDS=60
PN_RESOLVER_URL=

# ---- Compatibility with UnoAPI (optional overrides) ----
# AMQP_EXCHANGE=unoapi.outgoing
# AMQP_WEBHOOK_EXCHANGE=unoapi.brigde
# STATUS_PREFIX=unoapi-status:
# SESSION_CONFIG_PREFIX=unoapi-config:
