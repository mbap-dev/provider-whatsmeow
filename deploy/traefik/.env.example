# Domains
PROVIDER_HOST=whatsmeow.seu-dominio.com
TRAEFIK_DASHBOARD_HOST=traefik.seu-dominio.com

# Traefik / TLS
LETSENCRYPT_EMAIL=devops@seu-dominio.com
# Gere com: htpasswd -nb admin 'SENHA_FORTE'
TRAEFIK_DASHBOARD_USERS=admin:$apr1$changeme$changemechangeme.

# Provider image
PROVIDER_IMAGE=ghcr.io/mbap-dev/provider-whatsmeow:latest
WORKER_LOG_LEVEL=info

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Worker assignments (digits only)
WORKER_A_NUMBERS=5562991111111,5562992222222
WORKER_B_NUMBERS=5562993333333,5562994444444

# Optional outputs/integrations
WEBHOOK_BASE=
REDIS_URL=

# Postgres (optional — enables auth system + persistent metadata)
# Leave empty to keep file-based metadata store and skip auth.
# DATABASE_URL is accepted as alias for POSTGRES_URL.
POSTGRES_URL=
POSTGRES_USER=whatsmeow
POSTGRES_PASSWORD=whatsmeow
POSTGRES_DB=whatsmeow

# Postgres-backed auth (only active when POSTGRES_URL is set)
# On first boot with an empty users table the owner account is created.
# Leave blank to skip bootstrap (manage users manually or via API).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Always true behind Traefik TLS — marks the session cookie Secure.
AUTH_SECURE_COOKIE=true
SESSION_TTL_HOURS=168

# Optional dashboard auth (protects /, /assets, /api, /sessions)
UI_AUTH_ENABLED=false
UI_AUTH_USER=
UI_AUTH_PASS=
UI_AUTH_REALM=WhatsMeow Dashboard

# API token auth (recommended for external clients like Chatwoot)
API_AUTH_ENABLED=false
API_AUTH_TOKEN=
# Optional compatibility alias:
# UNOAPI_AUTH_TOKEN=
API_AUTH_ALLOW_QUERY=true

# Optional media storage (S3 fallback to local)
MEDIA_STORAGE_MODE=auto
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=
